{
  "name": "mental-legos",
  "productName": "Mental LEGOs",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Local-first language LEGO training for professional spoken communication.",
  "author": "Mental LEGOs Contributors",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run tests/architecture/eval-runner.test.ts",
    "eval:judge": "vitest run tests/architecture/judge-pass.test.ts",
    "eval:calibrate": "vitest run tests/architecture/judge-calibration.test.ts tests/architecture/judge-rubric-controls.test.ts",
    "guard:architecture": "node scripts/architecture-guard.mjs",
    "guard:privacy": "node scripts/privacy-scan.mjs",
    "guard:privacy:staged": "node scripts/privacy-scan.mjs --staged",
    "bundle:skills:write": "node scripts/skill-bundle-manifest.mjs --write",
    "guard:skills": "node scripts/skill-bundle-manifest.mjs",
    "probe:sdk:offline": "node scripts/sdk-offline-probe.mjs",
    "build:sandbox:windows": "node scripts/build-windows-sandbox.mjs",
    "build:bash-proxy:windows": "node scripts/build-native-bash-proxy.mjs",
    "probe:sandbox:windows": "npm run build:sandbox:windows && node scripts/windows-sandbox-probe.mjs",
    "probe:credentials:windows": "npm run build:sandbox:windows && node scripts/credential-vault-probe.mjs",
    "probe:packaged:windows": "node scripts/packaged-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run guard:architecture && npm run guard:skills && npm run guard:privacy"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.229",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sherpa-onnx-node": "1.13.4",
    "sherpa-onnx-win-x64": "1.13.4",
    "zod": "4.4.3"
  },
  "overrides": {
    "sherpa-onnx-darwin-arm64": "1.13.4",
    "sherpa-onnx-darwin-x64": "1.13.4",
    "sherpa-onnx-linux-arm64": "1.13.4",
    "sherpa-onnx-linux-x64": "1.13.4",
    "sherpa-onnx-win-ia32": "1.13.4",
    "sherpa-onnx-win-x64": "1.13.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "eslint": "10.8.1",
    "pdfjs-dist": "6.2.108",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
